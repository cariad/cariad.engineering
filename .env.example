# Copy this file to `.env` and fill in the values. Git ignores `.env`, so your
# keys stay on your machine. See `infra/README.md`.

# A Scaleway API key pair that can read the state bucket. OpenTofu reads the
# state through Scaleway's S3-compatible API, so the pair goes in the `AWS_*`
# variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Your bunny.net API key.
BUNNYNET_API_KEY=
